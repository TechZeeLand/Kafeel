# Copy this file to .env and adjust values before running docker compose.
# `cp .env.example .env`

# --- Web ---
WEB_PORT=1023
SITE_NAME="Kafeel (كَفِيلْ)"
SITE_URL=
CURRENCY_SYMBOL=৳

# --- Shipping ---
SHIPPING_INSIDE_DHAKA_FEE=80
SHIPPING_SUBURBS_FEE=100
SHIPPING_OUTSIDE_DHAKA_FEE=130
SHIPPING_FREE_WEIGHT_KG=1
SHIPPING_EXTRA_PER_KG=20
DELIVERY_DAYS_MIN=3
DELIVERY_DAYS_MAX=5

# --- Contact / social ---
CONTACT_EMAIL=hello@kafeelshopbd.com
CONTACT_PHONE=
SOCIAL_FACEBOOK=https://www.facebook.com/kafeelshopbd
SOCIAL_FACEBOOK_MESSENGER=https://www.m.me/kafeelshopbd
SOCIAL_INSTAGRAM=https://www.instagram.com/kafeelbd/
SOCIAL_YOUTUBE=https://www.youtube.com/@Kafeelbd

# --- Outbound email (PHPMailer). Leave SMTP_HOST blank to fall back to
# PHP's mail() function -- fine for a quick test, but most hosts (Gmail,
# Zoho, your registrar's mail server, etc.) need real SMTP creds to
# actually deliver mail reliably. Used for: contact form, email
# verification, and order status update notifications. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM_EMAIL=hello@kafeelshopbd.com
SMTP_FROM_NAME="Kafeel"

TZ=Asia/Dhaka
APP_DEBUG=0

# --- Database (MariaDB) ---
DB_NAME=kafeel_db
DB_USER=admin
DB_PASS=ChangeMe123!
DB_ROOT_PASS=ChangeMe123!

# --- phpMyAdmin (bundled DB UI, logs in with DB_USER / DB_PASS above) ---
PMA_PORT=1024
