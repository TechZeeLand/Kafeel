# Copy this file to .env and adjust values before running docker compose.
# `cp .env.example .env`

# --- Web ---
WEB_PORT=1023
SITE_NAME="Kafeel (كَفِيلْ)"
SITE_URL=
CURRENCY_SYMBOL=৳
SHIPPING_FLAT_FEE=80
FREE_SHIPPING_THRESHOLD=2000
TZ=Asia/Dhaka
APP_DEBUG=0

# --- Database (MariaDB) ---
DB_NAME=kafeel_db
DB_USER=admin
DB_PASS=ChangeMe123!
DB_ROOT_PASS=ChangeMe123!

# --- phpMyAdmin (bundled DB UI, logs in with DB_USER / DB_PASS above) ---
PMA_PORT=1024
