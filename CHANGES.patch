diff --git a/docker/nginx/default.conf b/docker/nginx/default.conf
index 4e652c1..8dae825 100755
--- a/docker/nginx/default.conf
+++ b/docker/nginx/default.conf
@@ -60,23 +60,30 @@ server {
     # ---------------------------------------------------------------------
     location = /product/ { return 301 /; }
     location ~ ^/product/([^/]+)/?$ {
-        rewrite ^ /product.php?slug=$1 break;
+        # The capture group must be repeated in THIS rewrite's own pattern. `$1` only ever
+        # reflects the most recently evaluated regex, and a bare `^` has no capturing groups
+        # of its own — nginx does not carry `$1` over from the `location ~` match into a
+        # later `rewrite`, so a bare `^` here silently rewrites to `slug=` (empty) on every
+        # request. This was the actual cause of pretty-URL category/product/order pages
+        # (and the site's own nav links to them) all coming up "not found" after the pretty-URL
+        # rollout — verified by reproducing it in isolation before fixing it here.
+        rewrite ^/product/([^/]+)/?$ /product.php?slug=$1&$args break;
         include /etc/nginx/fastcgi-php.conf;
     }
     location = /category/ { return 301 /; }
     location ~ ^/category/([^/]+)/?$ {
-        rewrite ^ /category.php?slug=$1 break;
+        rewrite ^/category/([^/]+)/?$ /category.php?slug=$1&$args break;
         include /etc/nginx/fastcgi-php.conf;
     }
     location ~ ^/order/([A-Za-z0-9\-]+)/?$ {
-        rewrite ^ /order-detail.php?order=$1 break;
+        rewrite ^/order/([A-Za-z0-9\-]+)/?$ /order-detail.php?order=$1&$args break;
         include /etc/nginx/fastcgi-php.conf;
     }
     location ~ ^/invoice/([A-Za-z0-9\-]+)/?$ {
-        rewrite ^ /invoice.php?order=$1 break;
+        rewrite ^/invoice/([A-Za-z0-9\-]+)/?$ /invoice.php?order=$1&$args break;
         include /etc/nginx/fastcgi-php.conf;
     }
-    location ~ ^/(cart|checkout|login|register|logout|account|addresses|orders|wishlist|search|contact|about|terms|privacy-policy|refund-policy|verify-email|resend-verification|order-success)/?$ {
+    location ~ ^/(cart|checkout|login|register|logout|account|addresses|orders|wishlist|search|contact|about|terms|privacy-policy|refund-policy|shipping-policy|verify-email|resend-verification|order-success)/?$ {
         rewrite ^/(.*?)/?$ /$1.php break;
         include /etc/nginx/fastcgi-php.conf;
     }
